<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ext="using:SourceGit.Extensions.AgentWorkspaces"
             x:Class="SourceGit.Extensions.AgentWorkspaces.WorkspaceSidebar"
             x:DataType="ext:AgentMode"
             IsVisible="{Binding IsActive}">
  <UserControl.Styles>
    <Style Selector="Grid.ws_item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Grid.ws_item:pointerover Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
      <Setter Property="Opacity" Value=".5"/>
    </Style>
    <Style Selector="Grid.ws_item.active Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value=".65"/>
    </Style>
    <Style Selector="Grid.ws_item.active:pointerover Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value=".8"/>
    </Style>
    <Style Selector="Grid.ws_item.active TextBlock.ws_name">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Grid.ws_item Button.ws_remove">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Grid.ws_item:pointerover Button.ws_remove">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Grid.ws_item.dimmed">
      <Setter Property="Opacity" Value=".4"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto">
  <Border Grid.Column="0" Width="{Binding PanelWidth}" Background="{DynamicResource Brush.SubPanel}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border0}">
    <Grid RowDefinitions="28,*,Auto">
      <TextBox Grid.Row="0" x:Name="SearchBox"
               Margin="4,2" Height="24"
               BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
               Background="Transparent"
               CornerRadius="4"
               Watermark="Find workspace (Enter to open)"
               Text="{Binding SearchText, Mode=TwoWay}"
               IsVisible="{Binding IsExpanded}"
               KeyDown="OnSearchKeyDown">
        <TextBox.InnerLeftContent>
          <Path Width="14" Height="14" Margin="4,0,0,0" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Search}"/>
        </TextBox.InnerLeftContent>
      </TextBox>

      <TextBlock Grid.Row="1" Classes="small" Margin="8,4,8,0" TextWrapping="Wrap" VerticalAlignment="Top"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="No agent workspaces yet. Ask an agent to show its changes in SourceGit and it will appear here."
                 IsVisible="{Binding ShowEmptyHint}"/>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="ext:AgentWorkspaceItem">
              <Grid Classes="ws_item" Classes.active="{Binding Workspace.IsActive}" Classes.dimmed="{Binding IsDimmed}" Tapped="OnItemTapped" ToolTip.Tip="{Binding Workspace.Name}">
                <Border x:Name="PART_Background" Background="Transparent" Opacity="0"/>
                <Border Margin="2,1" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent}" IsVisible="{Binding IsMatch}"/>

                <Grid Margin="0,4" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding $parent[ItemsControl].((ext:AgentMode)DataContext).IsExpanded}">
                  <Border Grid.Column="0" Width="3" Margin="6,0,8,0" CornerRadius="2" Background="{Binding Workspace.Brush}"/>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Classes="ws_name" Text="{Binding Workspace.Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="small" Text="{Binding RepoNames}" Foreground="{DynamicResource Brush.FG2}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon_button ws_remove" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Click="OnRemoveWorkspace" Tapped="OnSwallowTapped" ToolTip.Tip="Remove workspace and disconnect it from its session">
                    <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
                  </Button>
                </Grid>

                <Path Width="14" Height="14" Margin="9,7"
                      Data="{StaticResource Icons.Workspace}"
                      Fill="{Binding Workspace.Brush}"
                      IsVisible="{Binding !$parent[ItemsControl].((ext:AgentMode)DataContext).IsExpanded}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Review -->
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}" IsVisible="{Binding HasItems}">
        <Grid RowDefinitions="28,Auto,Auto,Auto,Auto" Margin="8,0,8,8" IsVisible="{Binding IsExpanded}">
          <TextBlock Grid.Row="0" Classes="group_header_label" VerticalAlignment="Center" Text="REVIEW"/>

          <TextBlock Grid.Row="1" Classes="small" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                     Text="Hover a change or select lines, files or commits, then press C to comment."
                     IsVisible="{Binding !Comments.Count}"/>

          <ScrollViewer Grid.Row="2" MaxHeight="320">
            <ItemsControl ItemsSource="{Binding Comments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="ext:ReviewComment">
                  <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="3" Background="{DynamicResource Brush.Contents}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="small bold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Snippet}"/>
                      <Button Grid.Row="0" Grid.Column="1" Classes="icon_button" Width="16" Click="OnRemoveComment" ToolTip.Tip="Remove">
                        <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
                      </Button>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0" Text="{Binding Text}" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBox Grid.Row="3" x:Name="NoteBox" Margin="0,2,0,6" Height="56" CornerRadius="3"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   Watermark="Overall note (optional) - Enter submits, Shift+Enter adds a line"
                   Text="{Binding ReviewSummary, Mode=TwoWay}"/>

          <StackPanel Grid.Row="4">
            <Button Classes="flat primary" Height="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsEnabled="{Binding CanSubmitReview}"
                    Click="OnSubmitReview">
              <ToolTip.Tip>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Send the review to the agent" VerticalAlignment="Center"/>
                  <TextBlock Margin="8,0,0,0"
                             Text="Enter in the note"
                             FontSize="11"
                             Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </ToolTip.Tip>
              <TextBlock>
                <Run Text="Submit review ("/><Run Text="{Binding Comments.Count}"/><Run Text=")"/>
                <Run Text=" "/>
                <Run FontWeight="Normal" FontSize="11" Text="Enter"/>
              </TextBlock>
            </Button>
            <TextBlock Classes="small" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding ReviewStatus}" IsVisible="{Binding ReviewStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>

  <Border Grid.Column="1" Width="4" Margin="-2,0,-2,0" Background="Transparent" Cursor="SizeWestEast"
          PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"
          ToolTip.Tip="Drag to resize, far left to collapse"/>
  </Grid>
</UserControl>
