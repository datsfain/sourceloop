<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             xmlns:ext="using:SourceGit.Extensions.AgentWorkspaces"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Extensions.AgentWorkspaces.DiffPageView"
             x:DataType="ext:DiffPage">
  <UserControl.DataTemplates>
    <DataTemplate DataType="ext:DiffRevision">
      <Grid RowDefinitions="Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <Path Grid.Column="0"
                Width="12" Height="12"
                VerticalAlignment="Center"
                Data="{Binding Icon}"/>
          <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2"
                     Margin="8,0,0,0"
                     Text="{Binding ShortSha}"
                     FontFamily="{DynamicResource Fonts.Monospace}"
                     Foreground="DarkOrange"/>
          <v:DateTimePresenter Grid.Column="4"
                               Margin="8,0,0,0"
                               Timestamp="{Binding Commit.CommitterTime}"
                               Foreground="{DynamicResource Brush.FG2}"
                               IsVisible="{Binding HasCommit}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="Auto,*" IsVisible="{Binding HasCommit}">
          <v:Avatar Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False" User="{Binding Commit.Author}"/>
          <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Commit.Subject}" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*" Margin="4" Background="{DynamicResource Brush.SubPanel}">
    <!-- Compared revisions -->
    <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="Auto,*,32,*,Auto,32,Auto">
      <ToggleButton Grid.Column="0"
                    Classes="sidebar_expander"
                    Width="32"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsFileListCollapsed, Mode=TwoWay}"/>

      <!-- Base Revision -->
      <Border Grid.Column="1"
              x:Name="BaseButton"
              BorderBrush="{DynamicResource Brush.Diff.DeletedHighlight}"
              BorderThickness="1"
              Background="{DynamicResource Brush.Contents}"
              CornerRadius="4"
              Padding="4"
              Cursor="Hand"
              Tapped="OnPickBase">
        <ContentControl Content="{Binding Base}" IsHitTestVisible="False"/>
      </Border>

      <!-- Swap Buttons -->
      <Button Grid.Column="2" Classes="icon_button" Command="{Binding Swap}" HorizontalAlignment="Center" ToolTip.Tip="Swap">
        <Path Width="16" Height="16" Data="{DynamicResource Icons.Compare}"/>
      </Button>

      <!-- Target Revision -->
      <Border Grid.Column="3"
              x:Name="TargetButton"
              BorderBrush="{DynamicResource Brush.Diff.AddedHighlight}"
              BorderThickness="1"
              Background="{DynamicResource Brush.Contents}"
              CornerRadius="4"
              Padding="4"
              Cursor="Hand"
              Tapped="OnPickTarget">
        <ContentControl Content="{Binding Target}" IsHitTestVisible="False"/>
      </Border>

      <CheckBox Grid.Column="4"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Merge base"
                IsChecked="{Binding UseMergeBase, Mode=TwoWay}"
                ToolTip.Tip="Diff against the common ancestor of base and target (base...target), like a pull request"/>

      <Button Grid.Column="5" Classes="icon_button" Width="32" Command="{Binding Reload}" ToolTip.Tip="Reload">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Loading}"/>
      </Button>

      <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.IsVisible>
          <Binding Path="TotalChanges" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
        </StackPanel.IsVisible>

      <TextBlock Margin="8,0,4,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="Mark selected files as viewed" Foreground="{DynamicResource Brush.FG1}"/>
            <Run Text=" "/>
            <Run Text="V" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <Run Text="{Binding ViewedCount, Mode=OneWay}" FontWeight="Bold"/>
        <Run Text="/"/>
        <Run Text="{Binding TotalChanges, Mode=OneWay}" FontWeight="Bold"/>
        <Run Text="viewed"/>
      </TextBlock>

        <Button Classes="icon_button"
                Width="28" Height="28"
                Command="{Binding UnviewAll}"
                IsEnabled="{Binding ViewedCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                ToolTip.Tip="Mark all files as not viewed">
          <Path Width="14" Height="14" Data="{StaticResource Icons.EyeClose}"/>
        </Button>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1"
               Margin="0,0,0,6"
               Foreground="DarkOrange"
               Text="{Binding Message}"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Files and diff -->
    <Grid Grid.Row="2" x:Name="Body">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.DiffLeftWidth, Mode=TwoWay}" MinWidth="200"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*" MinWidth="100"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowDefinitions="26,*,26" IsVisible="{Binding !IsFileListCollapsed}">
        <Grid Grid.Row="0" ColumnDefinitions="*,18">
          <TextBox Grid.Column="0"
                   x:Name="SearchBox"
                   Height="26"
                   BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
                   Background="Transparent"
                   CornerRadius="4"
                   Watermark="Search Changes..."
                   Text="{Binding SearchFilter, Mode=TwoWay}">
            <TextBox.InnerLeftContent>
              <Path Width="14" Height="14" Margin="4,0,0,0" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Search}"/>
            </TextBox.InnerLeftContent>

            <TextBox.InnerRightContent>
              <Button Classes="icon_button"
                      IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Command="{Binding ClearSearchFilter}">
                <Path Width="14" Height="14" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Clear}"/>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <v:ChangeViewModeSwitcher Grid.Column="1"
                                    Width="14" Height="14"
                                    HorizontalAlignment="Right"
                                    ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode, Mode=TwoWay}"/>
        </Grid>

        <Border Grid.Row="1" CornerRadius="4,4,0,0" Margin="0,4,0,0" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <Border CornerRadius="4,4,0,0" Background="{DynamicResource Brush.Contents}" ClipToBounds="True">
            <v:ChangeCollectionView x:Name="Files"
                                    ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode}"
                                    EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                    Changes="{Binding VisibleChanges, Mode=OneWay}"
                                    Selection="{Binding ChangeSelection, Mode=TwoWay}"
                                    KeyDown="OnFilesKeyDown"/>
          </Border>
        </Border>

        <v:LoadingIcon Grid.Row="1"
                       Width="48" Height="48"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsLoading}"/>

        <Border Grid.Row="2" CornerRadius="0,0,4,4" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1,0,1,1" Background="Transparent">
          <TextBlock Margin="4,0,0,0"
                     Foreground="{DynamicResource Brush.FG2}"
                     HorizontalAlignment="Left" VerticalAlignment="Center">
            <Run Text="{Binding TotalChanges, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text="changed file(s)"/>
          </TextBlock>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1"
                    x:Name="Splitter"
                    MinWidth="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent"
                    Focusable="False"/>

      <Grid Grid.Column="2">
        <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center"
                      IsVisible="{Binding DiffContext, Converter={x:Static ObjectConverters.IsNull}}">
            <Path Width="64" Height="64" Data="{StaticResource Icons.Diff}" Fill="{DynamicResource Brush.FG2}"/>
            <TextBlock Margin="0,16,0,0"
                       Text="{DynamicResource Text.Diff.Welcome}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding DiffContext}" Classes.viewed="{Binding IsCurrentViewed}">
          <ContentControl.Styles>
            <Style Selector="ContentControl.viewed">
              <Setter Property="Effect" Value="blur(14)"/>
              <Setter Property="Opacity" Value=".3"/>
            </Style>
          </ContentControl.Styles>

          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:DiffContext">
              <v:DiffView/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- Shown over the blurred diff of a file that is marked viewed -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsCurrentViewed}">
          <Path Width="48" Height="48" Data="{StaticResource Icons.Check}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Margin="0,8,0,0"
                     Text="VIEWED"
                     FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG1}"
                     HorizontalAlignment="Center"/>
          <TextBlock Margin="0,4,0,0"
                     Text="Press V to mark as not viewed"
                     Foreground="{DynamicResource Brush.FG2}"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
